{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": {
      "maxDuration": 120,
      "includeFiles": "{app/static/**,data/corpus/**}",
      "excludeFiles": "{tests/**,scripts/**,docs/**,data/filings/**,data/reference/**,data/golden/**,.venv/**,venv/**,.pytest-*/**,dependency-audit.json,eval-results.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
      ]
    },
    {"source": "/(query|corpus)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
